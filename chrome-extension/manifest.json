{
  "manifest_version": 3,
  "name": "公益站自动签到助手",
  "version": "1.0.11",
  "version_name": "1.11",
  "description": "支持NewAPI、Sub2API、积分签到、Sota Agent、Fengwind福利站等多类型站点的公益站自动签到工具",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "import-entry.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
